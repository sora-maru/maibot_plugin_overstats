{
  "manifest_version": 2,
  "id": "local.overstats",
  "name": "Overstats 守望先锋查询",
  "version": "1.1.1",
  "description": "面向 MaiBot 1.3.16 的 Overstats 桥接插件，连接已有后端，支持战绩、单局、榜单和资讯图片。",
  "author": {
    "name": "sora-maru; original by Zzzzzzouhang",
    "url": "https://github.com/sora-maru"
  },
  "license": "AGPL-3.0-only",
  "urls": {
    "repository": "https://github.com/sora-maru/maibot_plugin_overstats",
    "documentation": "https://github.com/sora-maru/maibot_plugin_overstats/blob/main/README.md",
    "issues": "https://github.com/sora-maru/maibot_plugin_overstats/issues"
  },
  "host_application": {
    "min_version": "1.3.16",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9,<4"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
