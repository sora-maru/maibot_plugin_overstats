# 配置页面已使用中文名称。手工配置的键名保持英文以兼容 1.0.0。

# 插件设置
[plugin]
# 启用插件：关闭后停止响应守望先锋查询。
enabled = true
# 配置版本：用于识别配置格式，保持默认即可。
config_version = "1.0.0"

# 后端连接与分流
[backend]
# Overstats 后端地址：填写麦麦可以访问的接口地址，仅填主机端口时自动补 /api/v2。
api_url = "http://127.0.0.1:18080/api/v2"
# 后端验证账号（可留空）：用于 HTTP Basic Auth，即浏览器弹出账号密码框的验证。留空表示不启用。所有配置的后端节点共用，请只填写可信节点。
auth_username = ""
# 后端验证密码（可留空）：对应 HTTP Basic Auth 密码；无验证时留空。网页登录表单、验证码或 Cloudflare 验证不能仅靠此处账号密码通过。
auth_password = ""
# 第二个后端地址：可选，用于是区吗专属分流；没有第二个后端时留空。
api_url_2 = ""
# 第三个后端地址：可选，用于是区吗专属分流；没有第三个后端时留空。
api_url_3 = ""
# 是区吗使用专属后端：开启后，是区吗生成及结果取图使用下面选择的节点。
shiqu_dedicated_enabled = false
# 是区吗专属地址：对应地址留空时回退主地址；优先于白名单分流。
shiqu_dedicated_address = "第二个地址"
# 管理员和白名单使用独立后端：开启后，管理员、白名单个人或群的其他查询使用独立节点。
privileged_backend_enabled = false
# 管理员和白名单后端地址：可选，留空回退主地址；结果取图与生成请求使用相同分流规则。
privileged_backend_url = ""
# 单次响应大小上限（MB）：超过上限的图片或响应会被拒绝，避免占用过多内存。
max_response_mb = 20
# 普通查询超时（秒）：普通查询最长等待时间；周度总结至少等待 900 秒。
request_timeout = 600
# AI 分析超时（秒）：是区吗、开庭最长等待时间；超时不自动重新生成。
ai_timeout = 1800
# 全部查询并发上限：保留上一版设置：同时执行的全部查询上限，0 表示不限；还会受轻重指令池限制。
max_concurrent = 4
# 每人同时查询上限：单个用户在全部聊天中的并发上限，0 表示不限。
per_user_max = 1

# 查询并发与限流
[concurrency]
# 启用每人并发限制：关闭后不限制单人并发，但总量和轻重指令池仍生效。
per_user_enabled = true
# 普通指令并发上限：战绩、榜单等普通查询同时执行数量，0 表示不限。
light_max = 0
# AI 重指令并发上限：仅是区吗和开庭的新生成任务，0 表示不限；结果取图属于普通指令。
heavy_max = 10
# 周度总结并发上限：周度总结较耗资源，额外限制同时执行数量，0 表示不限。
weekly_max = 2

# 指令与聊天提示
[chat]
# 直接发送战网ID自动绑定：开启后，发送完整的 Player#12345 即可绑定。
auto_bind = false
# 数字快捷查看单局：查询对局后五分钟内，发送 1~20 可查看上次查询玩家的对应单局。
number_shortcut = true
# 群聊快捷入口必须艾特机器人：限制直接发送战网ID和数字快捷入口；完整命令带不带 / 都可直接识别。
shortcuts_require_mention = false
# 文字艾特昵称：可选。支持“@此昵称 今日总结”；留空只识别宿主标记的真实艾特。
nickname = ""
# 显示开始查询提示：查询开始时发送等待提示；可用 /群设置 提示 开|关 单独覆盖。
status_prompt = true
# 每天只显示首次等待提示：同一用户在同一聊天每天只提示一次；失败后下次查询仍会提示。
daily_first_prompt_only = false
# 错误后追加操作提示：在错误信息后追加查看帮助或补取图片的提示。
error_append_hint = false
# 猜猜提示间隔（秒）：猜猜每阶段之间以及揭晓答案前的等待时间。
guess_interval = 15
# 图片缓存有效期（分钟）：/获取图片 可补取最近一组图片，缓存按用户和聊天隔离。
cache_minutes = 30
# 图片缓存总量上限（MB）：临时图片磁盘占用上限，超限时清理旧文件。
max_cache_mb = 100
# 保存图片到本地以便补取：关闭后直接发送内存中的图片，减少磁盘写入，但新图片无法用 /获取图片 补取。
save_image_locally = true

# 管理员、白名单与访问范围
[access]
# 插件管理员：每项填写 平台:用户ID，例如 qq:123456789；同时信任麦麦的本地操作员。
admin_users = []
# 个人白名单：例如 qq:123456789；可绕过维护限制，使用 AI 白名单冷却并免单局锐评每日限次。
user_whitelist = []
# 群白名单：例如 qq:987654321；群内成员享有白名单查询待遇，不会获得管理权限。
group_whitelist = []
# 允许使用的群：每项填写 平台:群ID，例如 qq:987654321；留空允许所有群，白名单也受此范围限制。
allowed_groups = []
# 允许私聊查询：关闭后所有私聊都不响应，包括管理员。
allow_private = true

# AI 分析与每日次数
[ai]
# 启用是区吗和开庭：总开关。开启后管理员与白名单可用，普通用户还需要下方开关。
enabled = false
# 允许普通用户使用 AI 分析：仅控制是区吗和开庭；单局锐评由下方独立开关控制。
normal_users = false
# 普通用户冷却时间（秒）：普通用户每类 AI 生成成功后的冷却时间，默认四小时；0 表示不限。
cooldown_seconds = 14400
# 白名单冷却时间（秒）：白名单每类 AI 生成成功后的冷却时间，默认半小时。
whitelist_cooldown_seconds = 1800
# 管理员冷却时间（秒）：管理员每类 AI 分析的冷却时间，默认 0 不限。
admin_cooldown_seconds = 0
# 是区吗默认分析局数：未指定局数时发送给后端的局数；更多局数可能增加后端 AI 用量。
match_count = 12
# 仅管理员和白名单可自定义局数：普通用户指定局数时忽略该数字，仍使用默认局数。
custom_count_privileged_only = true
# 启用单局 AI 锐评：开启后单局详细会请求后端锐评；追加“锐评关”可按次关闭。
match_review = false
# 限制普通用户每日锐评次数：超过次数后仍生成单局图片，但不再调用 AI 锐评；管理员和白名单不限。
review_limit_enabled = true
# 每日锐评次数上限：每个普通用户每天允许请求锐评的次数；0 表示普通用户只出图不锐评。
review_daily_limit = 3
# 每日次数重置时刻（北京时间）：按北京时间每天此整点开始新一天，默认凌晨四点。
review_reset_hour = 4
